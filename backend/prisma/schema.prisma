generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum LeadFlowStatus {
  NEW
  CONTACTED
  WAITING_FOR_DOCUMENTS
  PROCESSING_DOCUMENTS
  QUOTE_READY
  QUOTE_SENT
  QUOTE_ACCEPTED
  WAITING_SIGNATURE
  SIGNED
  WAITING_PAYMENT
  PAYMENT_COMPLETED
  POLICY_ISSUED
  ACTIVE_CUSTOMER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum InterestedIn {
  CARS
  HOME
  BUSINESS
  TRAVEL
  HEALTH
  OTHER
}

enum RenewalStatus {
  NOT_CONTACTED
  CONTACTED
  RENEWED
  DECLINED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  leads             Lead[]
  customers         Customer[] @relation("CustomerAgent")
  creditedCustomers Customer[] @relation("CustomerCreditedAgent")
  invitationsSent   Invitation[]
  emailAccounts     EmailAccount[]
  reminders         Reminder[]
  customerMessages  CustomerMessage[]
  uploadedDocuments PolicyDocument[]

  @@map("users")
}

model EmailAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, email])
  @@map("email_accounts")
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  name        String
  role        Role      @default(AGENT)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])

  @@index([email])
  @@map("invitations")
}

model Lead {
  id                 String              @id @default(uuid())
  leadNationalId     Int?                @unique // agent-entered lead national ID number, carried over to Customer.customerNationalId on conversion
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  leadFlowStatus     LeadFlowStatus      @default(NEW)
  leadStatus         LeadStatus          @default(NEW)
  pdfUrl             String?
  pricingPdfUrl      String?
  leadName           String
  phoneNumber        String
  idNumber           String?
  agentId            String?
  agent              User?               @relation(fields: [agentId], references: [id])
  leadFlowStatusLogs LeadFlowStatusLog[]

  // Person-specific fields
  age                 String?
  dateOfBirth         String?
  cost                String?
  yearOfLicenseIssued String?
  interestedIn        InterestedIn?

  // Insurance quote pricing (generated by the pricing engine on lead creation)
  mandatoryPrice     Float?
  thirdPartyPrice    Float?
  complimentaryPrice Float?

  // Optional fixed-price add-on services
  glassAndMoreSelected     Boolean @default(false)
  complementaryVipSelected Boolean @default(false)

  // Vehicle info fields (from Israeli gov vehicle API)
  misparRechev        String? // מספר רכב
  tozeretCd           String? // קוד תוצרת
  sugDegem            String? // סוג דגם
  tozeretNm           String? // שם תוצרת
  degemCd             String? // קוד דגם
  shnatYitzur         String? // שנת ייצור
  degemNm             String? // שם דגם
  ramatGimur          String? // רמת גימור
  ramatEivzurBetihuti String? // רמת אבזור בטיחותי
  kvutzatZihum        String? // קבוצת זיהום
  tzevaCd             String? // קוד צבע
  tzevaRechev         String? // צבע רכב
  zmigKidmi           String? // צמיג קדמי
  zmigAhori           String? // צמיג אחורי
  sugDelekNm          String? // סוג דלק
  horaatRishum        String? // הוראת רישום
  moedAliyaLakvish    String? // מועד עליה לכביש
  baalut              String? // בעלות
  misgeret            String? // מספר שילדה
  tozeretEretzNm      String? // ארץ תוצרת
  mishkalKolel        String? // משקל כולל
  nefahManoa          String? // נפח מנוע
  kinuyMishari        String? // כינוי מסחרי
  mivchanAcharonDt    String? // תאריך מבחן אחרון
  tokefDt             String? // תוקף רישוי
  taarichPkikaDt      String? // תאריך פקיעת תוקף
  taarichPkiah        String? // תאריך פקיעת תוקף
  kvuzatAgra          String? // קבוצת אגרה
  mahozMoshav         String? // מחוז מושב
  sugRechevNm         String? // סוג רכב
  degemManoa          String? // קוד מנוע
  koachSus            String? // כוח סוס
  misparDlatot        String? // מספר דלתות
  misparMoshavim      String? // מספר מושבים

  @@map("leads")
}

model LeadFlowStatusLog {
  id         String          @id @default(uuid())
  leadId     String
  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus LeadFlowStatus?
  toStatus   LeadFlowStatus
  changedBy  String?
  note       String?
  createdAt  DateTime        @default(now())

  @@map("lead_flow_status_logs")
}

model Customer {
  id                 String   @id @default(uuid())
  customerNationalId Int?     @unique // agent-entered customer national ID number; carried over from Lead.leadNationalId on conversion
  createdAt          DateTime @default(now())
  customerName       String
  email              String?
  idNumber           String?
  dateOfBirth        String?
  gender             String?
  insuranceAgent     String?
  agentName          String?
  purchaseType       String?
  uniqueId           String?
  pathNumber         String?
  healthFund         String?
  employer           String?
  signedGoodFaith    Boolean  @default(false)
  memberId           String?
  workPlace          String?
  carBrand           String?
  agentId            String?
  agent              User?    @relation("CustomerAgent", fields: [agentId], references: [id])
  convertedFromLead  Boolean  @default(false) // set true when created via Lead conversion (the source Lead row is deleted on conversion, so this is the only trail)

  // The agent credited with bringing in this customer, captured once at creation and never
  // touched again — so reassigning agentId later (to hand off ongoing account management)
  // never moves historical conversion/profit credit to the new agent.
  creditedAgentId String?
  creditedAgent   User?    @relation("CustomerCreditedAgent", fields: [creditedAgentId], references: [id])

  // Carried over from the source Lead on conversion
  phoneNumber         String?
  age                 String?
  cost                String?
  yearOfLicenseIssued String?
  interestedIn        InterestedIn?

  // Insurance quote pricing (carried over from the Lead's quote)
  mandatoryPrice     Float?
  thirdPartyPrice    Float?
  complimentaryPrice Float?

  // Cost price snapshot, captured from InsuranceCostPrice at conversion time so that later
  // edits to the global cost price never change this customer's already-recorded profit.
  mandatoryCostPrice     Float?
  thirdPartyCostPrice    Float?
  complimentaryCostPrice Float?

  // Optional fixed-price add-on services
  glassAndMoreSelected     Boolean @default(false)
  complementaryVipSelected Boolean @default(false)

  contacts        Contact[]
  policies        Policy[]
  vehicles        Vehicle[]
  reminders       Reminder[]
  messages        CustomerMessage[]
  policyDocuments PolicyDocument[]

  @@map("customers")
}

model Vehicle {
  id         String   @id @default(uuid())
  customerId String
  createdAt  DateTime @default(now())

  // Vehicle info fields (from Israeli gov vehicle API)
  misparRechev        String? // מספר רכב
  tozeretCd           String? // קוד תוצרת
  sugDegem            String? // סוג דגם
  tozeretNm           String? // שם תוצרת
  degemCd             String? // קוד דגם
  shnatYitzur         String? // שנת ייצור
  degemNm             String? // שם דגם
  ramatGimur          String? // רמת גימור
  ramatEivzurBetihuti String? // רמת אבזור בטיחותי
  kvutzatZihum        String? // קבוצת זיהום
  tzevaCd             String? // קוד צבע
  tzevaRechev         String? // צבע רכב
  zmigKidmi           String? // צמיג קדמי
  zmigAhori           String? // צמיג אחורי
  sugDelekNm          String? // סוג דלק
  horaatRishum        String? // הוראת רישום
  moedAliyaLakvish    String? // מועד עליה לכביש
  baalut              String? // בעלות
  misgeret            String? // מספר שילדה
  tozeretEretzNm      String? // ארץ תוצרת
  mishkalKolel        String? // משקל כולל
  nefahManoa          String? // נפח מנוע
  kinuyMishari        String? // כינוי מסחרי
  mivchanAcharonDt    String? // תאריך מבחן אחרון
  tokefDt             String? // תוקף רישוי
  taarichPkikaDt      String? // תאריך פקיעת תוקף
  taarichPkiah        String? // תאריך פקיעת תוקף
  kvuzatAgra          String? // קבוצת אגרה
  mahozMoshav         String? // מחוז מושב
  sugRechevNm         String? // סוג רכב
  degemManoa          String? // קוד מנוע
  koachSus            String? // כוח סוס
  misparDlatot        String? // מספר דלתות
  misparMoshavim      String? // מספר מושבים

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policies Policy[]

  @@map("vehicles")
}

model Contact {
  id         String @id @default(uuid())
  customerId String
  type       String // e.g., 'mobile', 'phone'
  value      String
  label      String
  icon       String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model Policy {
  id                       String        @id @default(uuid())
  customerId               String
  carId                    String?
  policyNumber             String
  policyType               String
  insuranceCompany         String
  agentName                String?
  carNumber                String?
  manufacturer             String?
  glassAndMoreSelected     Boolean       @default(false)
  complementaryVipSelected Boolean       @default(false)
  amountPaid               Float?
  startDate                DateTime?
  endDate                  DateTime?
  type                     String?
  status                   String        @default("Active") // 'Active' or 'Cancelled'
  renewalStatus            RenewalStatus @default(NOT_CONTACTED)
  fileId                   String? // deprecated: legacy single-attachment Cloudinary public_id, superseded by PolicyDocument
  fileUrl                  String? // deprecated: legacy single-attachment Cloudinary secure_url, superseded by PolicyDocument

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  car       Vehicle?         @relation(fields: [carId], references: [id], onDelete: Cascade)
  reminders Reminder[]
  documents PolicyDocument[]

  @@map("policies")
}

model PolicyDocument {
  id               String   @id @default(uuid())
  policyId         String? // optional: some document types (ID Card, Bank Details, ...) belong to the customer, not a specific policy
  customerId       String
  documentType     String // classified by Gemini, e.g. "ID Card", "Vehicle Test Certificate"
  fileId           String // Cloudinary public_id
  fileUrl          String // Cloudinary secure_url
  originalFilename String?
  ocrText          String? // full extracted text (future search/reference)
  uploadedById     String
  createdAt        DateTime @default(now())

  // Structured fields Gemini pulls off policy documents (Mandatory / Third Party / Third Party +
  // Complimentary insurance certificates) alongside classification. Null for document types that
  // don't carry this data (ID Card, Bank Details, ...) or when extraction found nothing usable.
  // Proposals only — never auto-applied to the Policy record without a human confirming, since a
  // misread field (e.g. monthly premium read as annual) would otherwise silently corrupt pricing.
  extractedInsuranceCompany String?
  extractedPolicyNumber     String?
  extractedPremiumAmount    Float? // always normalized to annual — see extractedPremiumBasis
  extractedPremiumBasis     String? // "ANNUAL" | "MONTHLY" — the unit the document actually quoted
  extractedStartDate        DateTime?
  extractedEndDate          DateTime?
  extractedClaimFreeYears   Int? // shin-nun years, feeds the pricing engine's claim-free discount band
  extractionSnippets        Json? // { fieldName: "verbatim source text" } so an agent can verify at a glance
  extractionFlagged         Boolean   @default(false) // premium fell outside the sanity range — needs manual review before use

  policy     Policy?  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@map("policy_documents")
}

model CustomerMessage {
  id          String   @id @default(uuid())
  customerId  String
  createdById String
  text        String
  createdAt   DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@map("customer_messages")
}

model Reminder {
  id          String   @id @default(uuid())
  customerId  String
  policyId    String?
  createdById String
  text        String
  remindAt    DateTime
  isRead      Boolean  @default(false)
  isAuto      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policy    Policy?  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@map("reminders")
}

model InsuranceCostPrice {
  id        String   @id @default(uuid())
  category  String   @unique // 'MANDATORY' | 'THIRD_PARTY' | 'COMPLIMENTARY'
  costPrice Float    @default(0)
  updatedAt DateTime @updatedAt

  @@map("insurance_cost_prices")
}
